{
  "name": "message-app",
  "version": "1.0.0",
  "description": "Modern Telegram-like messaging application",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd apps/backend && npm run dev",
    "dev:frontend": "cd apps/frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd apps/backend && npm run build",
    "build:frontend": "cd apps/frontend && npm run build",
    "start": "node apps/backend/dist/index.js",
    "prisma:migrate": "cd apps/backend && prisma migrate dev",
    "prisma:generate": "cd apps/backend && prisma generate",
    "prisma:seed": "cd apps/backend && prisma db seed",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "cd apps/backend && npm run lint",
    "lint:frontend": "cd apps/frontend && npm run lint",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd apps/backend && npm run test",
    "test:frontend": "cd apps/frontend && npm run test",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "workspaces": [
    "apps/backend",
    "apps/frontend",
    "packages/*"
  ],
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
